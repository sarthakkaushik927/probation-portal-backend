generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Domain {
  FRONTEND
  BACKEND
  APP
  UIUX
  CLOUD
  ML
  COMMON
}

enum StudentType {
  HOSTELER
  DAY_SCHOLAR
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum NotificationType {
  BROADCAST
  TASK_ASSIGNED
  SUBMISSION_STATUS
  ATTENDANCE
  TEAM_UPDATE
}

enum TaskType {
  INDIVIDUAL
  TEAM
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String
  role        Role     @default(USER)
  domain      Domain?
  avatarData  String?
  expoPushToken String?
  phoneNumber String?
  studentType StudentType?
  isVerified  Boolean        @default(false)
  attendance    Attendance[]
  submissions   Submission[]
  notifications Notification[]
  comments      Comment[]
  messages      Message[]
  taskAssignments TaskAssignment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  domain      Domain
  deadline    DateTime
  type        TaskType   @default(INDIVIDUAL)
  teamName    String?
  submissions    Submission[]
  teamSubmission TeamSubmission?
  attachments    String[]   @default([])
  assignedUsers  TaskAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([title, domain])
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([taskId, userId])
}

model TeamSubmission {
  id            String           @id @default(cuid())
  taskId        String           @unique
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  links         Json             @default("[]")  // Array of { name: string, url: string }
  attachments   String[]         @default([])
  remarks       String?
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Submission {
  id         String           @id @default(cuid())
  githubLink String
  demoLink   String
  remarks    String?
  status     SubmissionStatus @default(PENDING)
  userId     String
  taskId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comments   Comment[]
  attachments String[]        @default([])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Comment {
  id           String     @id @default(cuid())
  message      String
  submissionId String
  userId       String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model OTP {
  id          String       @id @default(cuid())
  email       String
  code        String
  expiresAt   DateTime
  isSignup    Boolean      @default(false)
  name        String?
  password    String?
  studentType StudentType?
  phoneNumber String?
  createdAt   DateTime     @default(now())
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  @@unique([userId, date])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  body      String
  type      NotificationType @default(BROADCAST)
  isRead    Boolean          @default(false)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments String[] @default([])
  createdAt DateTime @default(now())
}
